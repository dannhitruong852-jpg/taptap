        "v3-s06.mp3": "81e0916186690a7d2261cd47ede62b35e94eb1f9ebce32864010eebf096bc1fb"
      },
      "cues": [
        {
          "id": "s06-01",
          "text": "“It’s like surgery,” ",
          "emotion": "curious",
          "intensity": 1,
          "start": 0.0,
          "end": 1.315
        },
        {
          "id": "s06-02",
          "text": "he says.",
          "emotion": "curious",
          "intensity": 1,
          "start": 1.315,
