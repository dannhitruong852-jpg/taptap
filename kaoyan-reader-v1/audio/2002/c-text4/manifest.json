      "qa_status": "candidate"
    },
    "s07": {
      "id": "s07",
      "path": "./audio/2002/c-text4/v3-s07.opus",
      "mp3_path": "./audio/2002/c-text4/v3-s07.mp3",
      "duration_seconds": 8.369,
      "files": {
        "v3-s07.opus": "cac71858cf682d7f8f988cdfeb3f8216258a13c3cce26d73faa5dc6409b7a35c",
        "v3-s07.mp3": "e92d2434053972f8dc85c9800fb7cb09d1b4854a383e3688635a2cc114e14a86"
      },
      "cues": [
        {
          "id": "s07-01",
          "text": "“We don’t call those deaths homicides because the doctors didn’t intend to kill their patients, ",
          "emotion": "neutral",
          "intensity": 1,
          "start": 0.0,
          "end": 6.335
        },
        {
          "id": "s07-02",
          "text": "although they risked their death.",
          "emotion": "neutral",
          "intensity": 1,
          "start": 6.335,
          "end": 8.369
        }
      ],
      "actor_id": "13",
      "actor_sequence": [
        "13",
        "13"
      ],
      "emotion": "neutral",
      "intensity": 1,
      "c_mode_version": "v3-content-cast",
      "artificial_pause_ms": 0,
      "post_tempo": false,
      "qa_status": "candidate"
    },
    "s08": {
      "id": "s08",
      "path": "./audio/2002/c-text4/v3-s08.opus",
      "mp3_path": "./audio/2002/c-text4/v3-s08.mp3",
      "duration_seconds": 7.41,
      "files": {
        "v3-s08.opus": "76a85ebc40fda0c2ea1e5a904472dd8622b99f8571611a69512a32d8939a1002",
        "v3-s08.mp3": "1662e81898eb81e8e24c466e24ff2720bbcd9880bc16532eb81660c88b70e6a5"
      },
      "cues": [
        {
          "id": "s08-01",
          "text": "If you’re a physician, you can risk your patient’s suicide as long as you don’t intend their suicide.”",
          "emotion": "serious",
          "intensity": 1,
          "start": 0.0,
          "end": 7.41
        }
      ],
      "actor_id": "13",
      "actor_sequence": [
        "13"
      ],
      "emotion": "serious",
      "intensity": 1,
      "c_mode_version": "v3-content-cast",
      "artificial_pause_ms": 0,
      "post_tempo": false,
      "qa_status": "candidate"
    },
    "s09": {
      "id": "s09",
      "path": "./audio/2002/c-text4/v3-s09.opus",
      "mp3_path": "./audio/2002/c-text4/v3-s09.mp3",
      "duration_seconds": 12.4,
      "files": {
        "v3-s09.opus": "5bfc63d422414530c323ef5e9fc48d866f2cdfc6cfe783526e3d4ea2fe873b6a",
        "v3-s09.mp3": "ae35304b3038e0008f2b3eff1cc4062008ec0f741599397293350385f71ba21e"
      },
      "cues": [
        {
          "id": "s09-01",
          "text": "On another level, many in the medical community acknowledge that the assisted-suicide debate ",
          "emotion": "serious",
          "intensity": 1,
          "start": 0.0,
          "end": 4.465
        },
        {
          "id": "s09-02",
          "text": "has been fueled in part by the despair of patients for whom modern medicine has prolonged the physical agony of dying.",
          "emotion": "serious",
          "intensity": 1,
          "start": 4.465,
          "end": 12.4
        }
      ],
      "actor_id": "09",
      "actor_sequence": [
        "09",
        "09"
      ],
      "emotion": "serious",
      "intensity": 1,
      "c_mode_version": "v3-content-cast",
      "artificial_pause_ms": 0,
      "post_tempo": false,
      "qa_status": "candidate"
    },
    "s10": {
