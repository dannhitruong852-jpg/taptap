      "duration_seconds": 12.033,
      "files": {
        "v3-s10.opus": "96f1fc51092e4afe1f1e2b54f49522e570faf7a9ad8d3848a750e1e9c67a2246",
        "v3-s10.mp3": "748750bff7ad674b5325c42c21d88f964addb28bff5f7467cc88d7257b6a8868"
      },
      "cues": [
        {
          "id": "s10-01",
          "text": "Just three weeks before the Court’s ruling on physician-assisted suicide, ",
          "emotion": "neutral",
          "intensity": 1,
          "start": 0.0,
          "end": 4.377
        },
        {
          "id": "s10-02",
          "text": "the National Academy of Science (NAS) released a two-volume report, Approaching Death: Improving Care at the End of Life.",
          "emotion": "neutral",
          "intensity": 1,
          "start": 4.377,
          "end": 12.033
        }
      ],
      "actor_id": "09",
      "actor_sequence": [
        "09",
        "09"
      ],
      "emotion": "neutral",
      "intensity": 1,
      "c_mode_version": "v3-content-cast",
      "artificial_pause_ms": 0,
      "post_tempo": false,
      "qa_status": "candidate"
    },
    "s11": {
