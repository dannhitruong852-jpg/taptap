      },
      "cues": [
        {
          "id": "s12-01",
          "text": "The profession is taking steps to require young doctors to train in hospices, ",
          "emotion": "lively",
          "intensity": 1,
          "start": 0.0,
          "end": 4.081
        },
        {
          "id": "s12-02",
          "text": "to test knowledge of aggressive pain management therapies, to develop a Medicare billing code for hospital-based care, ",
          "emotion": "lively",
          "intensity": 1,
          "start": 4.081,
          "end": 10.747
        },
        {
          "id": "s12-03",
          "text": "and to develop new standards for assessing and treating pain at the end of life.",
          "emotion": "lively",
          "intensity": 1,
          "start": 10.747,
          "end": 15.624
        }
      ],
      "actor_id": "09",
      "actor_sequence": [
