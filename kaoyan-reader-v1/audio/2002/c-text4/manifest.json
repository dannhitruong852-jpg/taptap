        "v3-s11.mp3": "9da88ff0b14e846dd1f1c207b30b0e96efeb7da29eb7068caaa8a3ada3d2bd07"
      },
      "cues": [
        {
          "id": "s11-01",
          "text": "It identifies the undertreatment of pain and the aggressive use of “ineffectual and forced medical procedures ",
          "emotion": "neutral",
          "intensity": 1,
          "start": 0.0,
          "end": 6.621
        },
        {
          "id": "s11-02",
          "text": "that may prolong and even dishonor the period of dying” as the twin problems of end-of-life care.",
          "emotion": "neutral",
          "intensity": 1,
          "start": 6.621,
          "end": 12.748
        }
      ],
      "actor_id": "09",
      "actor_sequence": [
        "09",
        "09"
      ],
      "emotion": "neutral",
      "intensity": 1,
      "c_mode_version": "v3-content-cast",
      "artificial_pause_ms": 0,
      "post_tempo": false,
      "qa_status": "candidate"
    },
    "s12": {
      "id": "s12",
      "path": "./audio/2002/c-text4/v3-s12.opus",
      "mp3_path": "./audio/2002/c-text4/v3-s12.mp3",
