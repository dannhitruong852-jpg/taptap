      },
      "cues": [
        {
          "id": "s02-01",
          "text": "The behavioral sciences have been slow to change ",
          "emotion": "neutral",
          "intensity": 1,
          "start": 0.0,
          "end": 2.609
        },
        {
          "id": "s02-02",
          "text": "partly because the explanatory items often seem to be directly observed ",
          "emotion": "neutral",
          "intensity": 1,
          "start": 2.609,
          "end": 6.871
        },
        {
          "id": "s02-03",
          "text": "and partly because other kinds of explanations have been hard to find.",
          "emotion": "neutral",
          "intensity": 1,
          "start": 6.871,
          "end": 10.243
        }
